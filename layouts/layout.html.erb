<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= current_page.data.fetch("title", "Firehose.io") %></title>
    <meta name="description" content="Firehose 2.0 is real-time streaming for Rails over a dedicated PostgreSQL LISTEN/NOTIFY connection. WebSocket and SSE with database-backed replay. No ActionCable, no Redis.">
    <meta name="theme-color" content="#f2411c">
    <meta property="og:image" content="https://4v4zhxqq.ogplus.net/<%= current_page.request_path.sub(%r{\A/}, "").sub(%r{([^/])\z}, '\1/') %>">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind" %>
  </head>
  <body class="min-h-screen">
    <!-- Top navigation -->
    <header class="sticky top-0 z-40 border-b border-white/10 bg-ink/85 backdrop-blur supports-[backdrop-filter]:bg-ink/70">
      <div class="container-band flex h-14 items-center justify-between gap-6">
        <a href="/" class="text-[15px] font-bold tracking-tight text-white">
          Firehose<span class="text-brand-400">.io</span>
        </a>
        <nav class="flex items-center gap-5 sm:gap-7">
          <a class="nav-link" href="/v2/">Docs</a>
          <a class="nav-link" href="/v1/">v1&nbsp;<span class="text-white/40">(legacy)</span></a>
          <a class="nav-link hidden sm:inline" href="https://www.youtube.com/watch?v=N6kHjXtLspw">Talk</a>
          <a class="nav-link hidden sm:inline" href="https://twitter.com/firehoseio">Twitter</a>
          <a class="inline-flex items-center gap-2 rounded-lg bg-white/10 px-3 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-white/20" href="https://github.com/firehoseio/firehose">
            <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
            <span class="hidden sm:inline">GitHub</span>
          </a>
        </nav>
      </div>
    </header>

    <% if current_page.data["hero"] == "home" %>
      <!-- Marketing hero (homepage only) -->
      <section class="relative overflow-hidden bg-gradient-to-b from-brand-500 to-brand-700 text-white">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(80%_60%_at_50%_-10%,rgba(255,255,255,0.18),transparent_65%)]"></div>
        <div class="relative container-band py-20 sm:py-28">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-medium text-white/90">
            <span class="h-1.5 w-1.5 rounded-full bg-white"></span>
            Firehose 2.0 &middot; real-time streaming for Rails on PostgreSQL
          </div>
          <h1 class="mt-6 text-5xl font-extrabold leading-none tracking-tight sm:text-7xl">
            Firehose<span class="font-light text-white/50">.io</span>
          </h1>
          <p class="mt-5 max-w-2xl text-xl font-medium text-white/90 sm:text-2xl">
            WebSocket and SSE streaming for Rails over a dedicated PostgreSQL
            LISTEN/NOTIFY connection, with database-backed replay.
            No ActionCable, no Redis.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <div class="cmd" id="install-cmd">
              <span>bundle add firehose</span>
              <button type="button" data-copy="bundle add firehose"
                      class="ml-1 rounded-md px-2 py-0.5 text-xs font-semibold text-white/60 transition-colors hover:bg-white/10 hover:text-white"
                      aria-label="Copy install command">copy</button>
            </div>
            <a href="/v2/"
               class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-ink shadow-sm transition-transform hover:-translate-y-0.5">
              Read the 2.0 docs
            </a>
            <a href="https://github.com/firehoseio/firehose"
               class="inline-flex items-center gap-2 rounded-xl border border-white/25 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">
              Fork it on GitHub
            </a>
          </div>
        </div>
      </section>
    <% else %>
      <!-- Compact documentation header -->
      <section class="border-b border-white/10 bg-ink">
        <div class="container-band py-10 sm:py-14">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
            <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              <%= current_page.data.fetch("doc_title", current_page.data.fetch("title", "Firehose.io")) %>
            </h1>
            <% case current_page.data["doc_status"] %>
            <% when "current" %>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-semibold text-emerald-300 ring-1 ring-inset ring-emerald-500/30">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                <%= current_page.data.fetch("doc_badge", "current") %> &middot; Current
              </span>
            <% when "legacy" %>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/15 px-3 py-1 text-xs font-semibold text-amber-300 ring-1 ring-inset ring-amber-500/30">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
                <%= current_page.data.fetch("doc_badge", "legacy") %> &middot; Legacy
              </span>
            <% end %>
          </div>
          <% if current_page.data["doc_subtitle"] %>
            <p class="mt-3 max-w-2xl text-lg text-white/70"><%= current_page.data["doc_subtitle"] %></p>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- Content -->
    <main class="bg-white">
      <div class="container-band py-16 sm:py-20">
        <article class="prose prose-firehose prose-stone mx-auto">
          <%= yield %>
        </article>
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-200 bg-stone-50">
      <div class="container-band flex flex-col items-center justify-between gap-4 py-10 text-sm text-ink-mute sm:flex-row">
        <p>
          <span class="font-semibold text-ink">Firehose<span class="text-brand-500">.io</span></span>
          &nbsp;&middot;&nbsp; Real-time streaming for Rails on PostgreSQL.
        </p>
        <nav class="flex items-center gap-6">
          <a class="transition-colors hover:text-brand-600" href="/v2/">Docs</a>
          <a class="transition-colors hover:text-brand-600" href="/v1/">v1 (legacy)</a>
          <a class="transition-colors hover:text-brand-600" href="https://github.com/firehoseio/firehose">GitHub</a>
          <a class="transition-colors hover:text-brand-600" href="https://twitter.com/firehoseio">Twitter</a>
        </nav>
      </div>
    </footer>

    <script>
      // Progressive copy-to-clipboard for command chips.
      document.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-copy]");
        if (!btn || !navigator.clipboard) return;
        navigator.clipboard.writeText(btn.getAttribute("data-copy")).then(function () {
          var prev = btn.textContent;
          btn.textContent = "copied";
          setTimeout(function () { btn.textContent = prev; }, 1400);
        });
      });
    </script>
  </body>
</html>
